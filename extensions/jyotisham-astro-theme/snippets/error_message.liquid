{% comment %}
  Error message snippet
  Usage: {% render 'error_message', message: 'Something went wrong', type: 'error' %}
{% endcomment %}

{% assign message = message | default: 'An error occurred' %}
{% assign type = type | default: 'error' %}
{% assign show_icon = show_icon | default: true %}

{% case type %}
  {% when 'error' %}
    {% assign bg_color = '#f8d7da' %}
    {% assign border_color = '#dc3545' %}
    {% assign text_color = '#721c24' %}
    {% assign icon = '⚠️' %}
  {% when 'warning' %}
    {% assign bg_color = '#fff3cd' %}
    {% assign border_color = '#ffc107' %}
    {% assign text_color = '#856404' %}
    {% assign icon = '⚠️' %}
  {% when 'info' %}
    {% assign bg_color = '#d1ecf1' %}
    {% assign border_color = '#17a2b8' %}
    {% assign text_color = '#0c5460' %}
    {% assign icon = 'ℹ️' %}
  {% when 'success' %}
    {% assign bg_color = '#d4edda' %}
    {% assign border_color = '#28a745' %}
    {% assign text_color = '#155724' %}
    {% assign icon = '✅' %}
  {% else %}
    {% assign bg_color = '#f8d7da' %}
    {% assign border_color = '#dc3545' %}
    {% assign text_color = '#721c24' %}
    {% assign icon = '⚠️' %}
{% endcase %}

<div class="message-container" 
     style="background: {{ bg_color }}; 
            padding: 15px 20px; 
            border-radius: 8px; 
            border-left: 4px solid {{ border_color }}; 
            margin: 10px 0;">
  
  <div style="display: flex; align-items: center;">
    {% if show_icon %}
      <span style="font-size: 18px; margin-right: 10px;">{{ icon }}</span>
    {% endif %}
    <div style="color: {{ text_color }}; font-size: 14px; line-height: 1.4;">
      {{ message }}
    </div>
  </div>
</div>
