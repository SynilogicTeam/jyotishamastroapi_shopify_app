{% comment %}
  Loading spinner snippet
  Usage: {% render 'loading_spinner', size: '40px', color: '#667eea' %}
{% endcomment %}

{% assign size = size | default: '40px' %}
{% assign color = color | default: '#667eea' %}
{% assign text = text | default: 'Loading...' %}

<div class="loading-container" style="text-align: center; padding: 20px;">
  <div class="loading-spinner" 
       style="border: 4px solid #f3f3f3; 
              border-top: 4px solid {{ color }}; 
              border-radius: 50%; 
              width: {{ size }}; 
              height: {{ size }}; 
              animation: spin 1s linear infinite; 
              margin: 0 auto;"></div>
  {% if text %}
    <p style="margin-top: 15px; color: {{ color }}; font-size: 14px;">{{ text }}</p>
  {% endif %}
</div>

<style>
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>
